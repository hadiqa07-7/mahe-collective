@model Mahe.Models.Product

@{
    Layout = "../Shared/_Layout.cshtml";
}

<div class="container">

    <h1>Edit Product</h1>

    <form method="post"
          action="/Admin/EditProduct">

        <input type="hidden"
               asp-for="Id" />

        <input asp-for="Name"
               placeholder="Product Name" />

        <input asp-for="Price"
               placeholder="Price" />

        <input asp-for="ImageUrl"
               placeholder="Image URL" />

        <input asp-for="Stock"
               placeholder="Stock" />
        <input asp-for="SizeChart"
               placeholder="Size Chart" />

        <textarea asp-for="Description"
                  placeholder="Description"></textarea>

        <button type="submit"
                class="pay-btn">

            Save Changes

        </button>

    </form>

</div>